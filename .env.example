# Copy to .env (start.bat creates .env and MCP_SECRET for you). Never commit .env.
# Generate a secret manually with:  python -c "import secrets; print(secrets.token_hex(24))"
MCP_SECRET=replace-with-24-plus-random-characters

# Optional settings (defaults shown)
# WORKSPACE_ROOT=./workspace
# MCP_ROLE=writer          # "reader" exposes read-only tools only
# PORT=8000
# LOG_DIR=./logs
# MAX_BYTES=1000000
# TUNNEL_HOST is set by start.bat / pm2 each time the quick tunnel restarts
